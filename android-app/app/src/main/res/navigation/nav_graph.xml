<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="com.musichub.ui.fragment.HomeFragment"
        android:label="@string/nav_home_cn"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_home_to_add_song"
            app:destination="@id/nav_add_song" />

    </fragment>

    <fragment
        android:id="@+id/nav_library"
        android:name="com.musichub.ui.fragment.LibraryFragment"
        android:label="@string/nav_library_cn"
        tools:layout="@layout/fragment_library">

        <action
            android:id="@+id/action_library_to_add_song"
            app:destination="@id/nav_add_song" />

    </fragment>

    <fragment
        android:id="@+id/nav_playlists"
        android:name="com.musichub.ui.fragment.PlaylistsFragment"
        android:label="@string/nav_playlists_cn"
        tools:layout="@layout/fragment_playlists">

        <action
            android:id="@+id/action_playlists_to_detail"
            app:destination="@id/nav_playlist_detail" />

    </fragment>

    <fragment
        android:id="@+id/nav_discover"
        android:name="com.musichub.ui.fragment.DiscoverFragment"
        android:label="@string/nav_discover_cn"
        tools:layout="@layout/fragment_discover">

        <action
            android:id="@+id/action_discover_to_chart_detail"
            app:destination="@id/nav_chart_detail" />

        <action
            android:id="@+id/action_discover_to_browse_playlist_detail"
            app:destination="@id/nav_browse_playlist_detail" />

    </fragment>

    <fragment
        android:id="@+id/nav_chart_detail"
        android:name="com.musichub.ui.fragment.ChartDetailFragment"
        android:label=""
        tools:layout="@layout/fragment_chart_detail">

        <argument
            android:name="chartPlatform"
            app:argType="string" />

        <argument
            android:name="chartId"
            app:argType="string" />

        <argument
            android:name="chartName"
            app:argType="string" />

    </fragment>

    <fragment
        android:id="@+id/nav_browse_playlist_detail"
        android:name="com.musichub.ui.fragment.BrowsePlaylistDetailFragment"
        android:label=""
        tools:layout="@layout/fragment_browse_playlist_detail">

        <argument
            android:name="platform"
            app:argType="string" />

        <argument
            android:name="playlistId"
            app:argType="string" />

        <argument
            android:name="playlistName"
            app:argType="string" />

    </fragment>

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.musichub.ui.fragment.SettingsFragment"
        android:label="@string/nav_settings_cn">

        <action
            android:id="@+id/action_settings_to_skip_log"
            app:destination="@id/nav_skip_log" />

    </fragment>

    <fragment
        android:id="@+id/nav_skip_log"
        android:name="com.musichub.ui.fragment.SkipLogFragment"
        android:label="@string/skip_log_title"
        tools:layout="@layout/fragment_skip_log" />

    <fragment
        android:id="@+id/nav_playlist_detail"
        android:name="com.musichub.ui.fragment.PlaylistDetailFragment"
        android:label=""
        tools:layout="@layout/fragment_playlist_detail">

        <argument
            android:name="playlistId"
            app:argType="long" />

        <argument
            android:name="playlistName"
            app:argType="string"
            android:defaultValue="歌单" />

        <action
            android:id="@+id/action_detail_to_add_song"
            app:destination="@id/nav_add_song" />

        <action
            android:id="@+id/action_detail_to_import_from_library"
            app:destination="@id/nav_import_from_library" />

        <action
            android:id="@+id/action_detail_to_manage_sources"
            app:destination="@id/nav_manage_sources" />

    </fragment>

    <fragment
        android:id="@+id/nav_add_song"
        android:name="com.musichub.ui.fragment.AddSongFragment"
        android:label="@string/add_song_cn"
        tools:layout="@layout/fragment_add_song">

        <argument
            android:name="playlistId"
            app:argType="long"
            android:defaultValue="-1L" />

    </fragment>

    <fragment
        android:id="@+id/nav_import_from_library"
        android:name="com.musichub.ui.fragment.ImportFromLibraryFragment"
        android:label="@string/import_screen_title"
        tools:layout="@layout/fragment_import_from_library">

        <argument
            android:name="playlistId"
            app:argType="long" />

    </fragment>

    <fragment
        android:id="@+id/nav_manage_sources"
        android:name="com.musichub.ui.fragment.ManageSourcesFragment"
        android:label="@string/sync_manage_sources_title"
        tools:layout="@layout/fragment_manage_sources">

        <argument
            android:name="playlistId"
            app:argType="long" />

    </fragment>

</navigation>
