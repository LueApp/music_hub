<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="播放控制"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:key="floating_window"
            android:title="@string/enable_floating_window_cn"
            android:summary="@string/floating_window_desc_cn"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="auto_advance"
            android:title="@string/enable_auto_advance_cn"
            android:summary="@string/auto_advance_desc_cn"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="权限"
        app:iconSpaceReserved="false">

        <Preference
            android:key="notification_access"
            android:title="@string/notification_access_cn"
            android:summary="@string/notification_access_desc_cn"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="accessibility_access"
            android:title="无障碍服务权限"
            android:summary="用于前台模式下自动打开QQ音乐播放器页面"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="write_settings_access"
            android:title="修改系统设置权限"
            android:summary="用于横屏时自动修复网易云音乐方向检测"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="数据管理"
        app:iconSpaceReserved="false">

        <Preference
            android:key="delete_all_songs"
            android:title="删除所有歌曲"
            android:summary="清空歌曲库（不影响播放列表）"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="关于"
        app:iconSpaceReserved="false">

        <Preference
            android:key="version"
            android:title="版本"
            android:summary="1.0.0"
            android:selectable="false"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

</PreferenceScreen>
