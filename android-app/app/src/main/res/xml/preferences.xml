<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="启动模式"
        app:iconSpaceReserved="false">

        <ListPreference
            android:key="launch_mode"
            android:title="音乐应用启动方式"
            android:summary="当前模式: 后台模式"
            android:entries="@array/launch_mode_entries"
            android:entryValues="@array/launch_mode_values"
            android:defaultValue="background"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="shizuku_status"
            android:title="Shizuku 授权"
            android:summary="后台小窗启动需要 Shizuku 提供 shell 权限"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="auto_grant_via_shizuku"
            android:title="@string/auto_grant_via_shizuku_cn"
            android:summary="@string/auto_grant_via_shizuku_desc_cn"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="launch_mode_health"
            android:title="@string/launch_mode_health_title"
            android:summary="@string/launch_mode_health_summary_ok"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="播放控制"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:key="floating_window"
            android:title="@string/enable_floating_window_cn"
            android:summary="@string/floating_window_desc_cn"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:key="nudge_decoration"
            android:title="@string/nudge_decoration_title_cn"
            android:summary="@string/nudge_decoration_summary_cn"
            android:entries="@array/nudge_decoration_entries"
            android:entryValues="@array/nudge_decoration_values"
            android:defaultValue="note"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="auto_advance"
            android:title="@string/enable_auto_advance_cn"
            android:summary="@string/auto_advance_desc_cn"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="qqmusic_auto_open_player"
            android:title="@string/qqmusic_auto_open_player_cn"
            android:summary="@string/qqmusic_auto_open_player_desc_cn"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="权限"
        app:iconSpaceReserved="false">

        <Preference
            android:key="overlay_access"
            android:title="@string/overlay_access_cn"
            android:summary="@string/overlay_access_desc_cn"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="notification_access"
            android:title="@string/notification_access_cn"
            android:summary="@string/notification_access_desc_cn"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="accessibility_access"
            android:title="@string/accessibility_access_cn"
            android:summary="@string/accessibility_service_desc_cn"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="restore_a11y_now"
            android:title="@string/restore_all_perms_now_cn"
            android:summary="@string/restore_all_perms_now_desc_cn"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="wake_path_access"
            android:title="@string/wake_path_access_cn"
            android:summary="@string/wake_path_access_desc_cn"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="auto_confirm_wakepath"
            android:title="@string/auto_confirm_wakepath_cn"
            android:summary="@string/auto_confirm_wakepath_desc_cn"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="write_settings_access"
            android:title="@string/write_settings_cn"
            android:summary="@string/write_settings_desc_cn"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="usage_stats_access"
            android:title="@string/usage_stats_cn"
            android:summary="@string/usage_stats_desc_cn"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="远程控制"
        app:iconSpaceReserved="false">

        <ListPreference
            android:key="remote_mode"
            android:title="远程控制模式"
            android:summary="当前模式: 独立运行"
            android:entries="@array/remote_mode_entries"
            android:entryValues="@array/remote_mode_values"
            android:defaultValue="standalone"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            android:key="remote_server_ip"
            android:title="服务器地址"
            android:summary="输入播放手机的IP地址"
            android:defaultValue=""
            app:iconSpaceReserved="false" />

        <Preference
            android:key="remote_status"
            android:title="连接状态"
            android:summary="未连接"
            android:selectable="false"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="remote_reconnect_now"
            android:title="@string/remote_reconnect_now_cn"
            android:summary="@string/remote_reconnect_now_desc_cn"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="数据管理"
        app:iconSpaceReserved="false">

        <Preference
            android:key="skip_log"
            android:title="@string/skip_log_title"
            android:summary="@string/skip_log_desc"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="delete_all_songs"
            android:title="删除所有歌曲"
            android:summary="清空歌曲库（不影响播放列表）"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="data_export"
            android:title="导出数据"
            android:summary="将曲库与歌单导出为 JSON 备份文件"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="data_import"
            android:title="导入数据"
            android:summary="从 JSON 备份文件恢复曲库与歌单"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="关于"
        app:iconSpaceReserved="false">

        <Preference
            android:key="version"
            android:title="版本"
            android:selectable="false"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

</PreferenceScreen>
