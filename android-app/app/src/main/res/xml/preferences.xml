<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="播放控制"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:key="floating_window"
            android:title="@string/enable_floating_window_cn"
            android:summary="@string/floating_window_desc_cn"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="auto_advance"
            android:title="@string/enable_auto_advance_cn"
            android:summary="@string/auto_advance_desc_cn"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:key="qqmusic_auto_open_player"
            android:title="@string/qqmusic_auto_open_player_cn"
            android:summary="@string/qqmusic_auto_open_player_desc_cn"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="权限"
        app:iconSpaceReserved="false">

        <Preference
            android:key="notification_access"
            android:title="@string/notification_access_cn"
            android:summary="@string/notification_access_desc_cn"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="accessibility_access"
            android:title="无障碍服务权限"
            android:summary="用于前台模式下自动打开QQ音乐播放器页面"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="write_settings_access"
            android:title="修改系统设置权限"
            android:summary="用于横屏时自动修复网易云音乐方向检测"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="usage_stats_access"
            android:title="应用使用情况权限"
            android:summary="用于浮窗双击智能导航功能"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="远程控制"
        app:iconSpaceReserved="false">

        <ListPreference
            android:key="remote_mode"
            android:title="远程控制模式"
            android:summary="当前模式: 独立运行"
            android:entries="@array/remote_mode_entries"
            android:entryValues="@array/remote_mode_values"
            android:defaultValue="standalone"
            app:iconSpaceReserved="false" />

        <EditTextPreference
            android:key="remote_server_ip"
            android:title="服务器地址"
            android:summary="输入播放手机的IP地址"
            android:defaultValue=""
            app:iconSpaceReserved="false" />

        <Preference
            android:key="remote_status"
            android:title="连接状态"
            android:summary="未连接"
            android:selectable="false"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="remote_reconnect_now"
            android:title="@string/remote_reconnect_now_cn"
            android:summary="@string/remote_reconnect_now_desc_cn"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="数据管理"
        app:iconSpaceReserved="false">

        <Preference
            android:key="skip_log"
            android:title="@string/skip_log_title"
            android:summary="@string/skip_log_desc"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="delete_all_songs"
            android:title="删除所有歌曲"
            android:summary="清空歌曲库（不影响播放列表）"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="data_export"
            android:title="导出数据"
            android:summary="将曲库与歌单导出为 JSON 备份文件"
            app:iconSpaceReserved="false" />

        <Preference
            android:key="data_import"
            android:title="导入数据"
            android:summary="从 JSON 备份文件恢复曲库与歌单"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="关于"
        app:iconSpaceReserved="false">

        <Preference
            android:key="version"
            android:title="版本"
            android:summary="1.0.0"
            android:selectable="false"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

</PreferenceScreen>
