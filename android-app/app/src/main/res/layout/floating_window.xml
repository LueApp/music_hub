<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_floating_window"
    android:padding="12dp"
    android:elevation="8dp">

    <!-- Song info row -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivAlbumCover"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_album"
            android:scaleType="centerCrop"
            android:background="@color/divider"
            android:contentDescription="@string/now_playing" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/tvSongTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:maxLines="1"
                android:ellipsize="end"
                android:maxWidth="120dp" />

            <TextView
                android:id="@+id/tvArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_recent_plays_cn"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:maxLines="1"
                android:ellipsize="end"
                android:maxWidth="120dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Progress bar row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/tvCurrentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textSize="10sp"
            android:textColor="@color/text_secondary" />

        <SeekBar
            android:id="@+id/seekBarProgress"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:max="100"
            android:progress="0"
            android:thumbTint="@color/primary"
            android:progressTint="@color/primary"
            android:progressBackgroundTint="@color/divider" />

        <TextView
            android:id="@+id/tvTotalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textSize="10sp"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

    <!-- Control buttons row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp">

        <ImageButton
            android:id="@+id/btnShuffle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_shuffle"
            android:background="@null"
            android:alpha="0.5"
            android:contentDescription="随机播放" />

        <ImageButton
            android:id="@+id/btnPrevious"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_skip_previous"
            android:background="@null"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/previous" />

        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_pause_circle"
            android:background="@null"
            android:layout_marginStart="4dp"
            android:contentDescription="播放/暂停" />

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_skip_next"
            android:background="@null"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/next" />

        <ImageButton
            android:id="@+id/btnRepeat"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_repeat"
            android:background="@null"
            android:alpha="0.5"
            android:layout_marginStart="4dp"
            android:contentDescription="循环模式" />

        <ImageButton
            android:id="@+id/btnQueue"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_queue_music"
            android:background="@null"
            android:alpha="0.7"
            android:layout_marginStart="4dp"
            android:contentDescription="播放列表" />

        <ImageButton
            android:id="@+id/btnMinimize"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_minimize"
            android:background="@null"
            android:layout_marginStart="4dp"
            android:contentDescription="最小化" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_close"
            android:background="@null"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/close" />

    </LinearLayout>

    <!-- Queue list (collapsible) -->
    <LinearLayout
        android:id="@+id/queueContainer"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:background="@color/surface">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/tvQueueHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="播放队列"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:padding="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvQueue"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:nestedScrollingEnabled="true"
            android:overScrollMode="never" />

    </LinearLayout>

</LinearLayout>
